{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "types": ["cypress", "node"],
    "noEmit": true
  },
  "include": ["cypress.config.ts", "cypress/**/*.ts"],
  "exclude": ["node_modules", "cypress/submission-setup"]
}
